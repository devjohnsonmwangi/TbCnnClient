# API Configuration - REQUIRED FOR PRODUCTION
# Set the full URL to your backend API

# Option 1: Full URL (recommended for production)
VITE_API_BASE_URL=https://api.yourdomain.com

# Option 2: If your API is on the same domain, use this pattern
# VITE_API_BASE_URL=http://localhost:3000

# Or leave empty to enable auto-detection (recommended)
# VITE_API_BASE_URL=

# API Timeout in milliseconds
VITE_API_TIMEOUT=90000

# Environment: development, staging, production
VITE_ENV=production

# Redux Debug Mode
DEBUG_REDUX=false

# Feature Flags
VITE_ENABLE_TB_DETECTION=true
