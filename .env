# API Configuration
# For production: Set VITE_API_BASE_URL to your backend URL
# For development: Leave empty to use localhost:3000 auto-detection
# Examples:
#   VITE_API_BASE_URL=https://api.yourdomain.com
#   VITE_API_BASE_URL=http://localhost:3000
# If not set, will auto-detect from current domain in production

# Leave empty for auto-detection (recommended for production)
VITE_API_BASE_URL=

# API Timeout (milliseconds)
VITE_API_TIMEOUT=90000

# Environment
VITE_ENV=development

# Debug Mode (enables Redux DevTools action tracing)
DEBUG_REDUX=true

# Feature Flags
VITE_ENABLE_TB_DETECTION=true
