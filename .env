# Redux Store Configuration - Environment Variables

# API Configuration (Backend on port 3000)
VITE_API_URL=http://localhost:3000

# API Timeout
VITE_API_TIMEOUT=30000

# Environment
VITE_ENV=development

# Debug Mode (enables Redux DevTools action tracing)
DEBUG_REDUX=true

# Feature Flags
VITE_ENABLE_TB_DETECTION=true
